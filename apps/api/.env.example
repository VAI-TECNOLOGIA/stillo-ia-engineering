# API — copie para .env (herda valores da raiz; ver ../../.env.example)
NODE_ENV=development
API_PORT=3333

DATABASE_URL=postgresql://stillo:stillo@localhost:5432/stillo?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=troque-isto-access
JWT_REFRESH_SECRET=troque-isto-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Criptografia de segredos em repouso (chave OpenAI por tenant). Use string forte.
ENCRYPTION_KEY=troque-isto-uma-chave-mestra-forte

# Fila de processamento: inline (dev, processa na hora) | bullmq (prod, usa Redis)
QUEUE_DRIVER=inline

# IA — fallback global. O ideal é cada tenant vincular a própria chave em Configurações.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_BASE_URL=https://api.openai.com/v1

OCR_PROVIDER=tesseract

STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=stillo-uploads
