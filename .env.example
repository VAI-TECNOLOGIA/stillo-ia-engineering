# ───────────────────────────────────────────────────────────────
# STILLO IA ENGINEERING — variáveis de ambiente (raiz / compartilhado)
# Copie para .env e preencha. NUNCA commite o .env real.
# ───────────────────────────────────────────────────────────────

# App
NODE_ENV=development
API_PORT=3333
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:3333

# Banco (Postgres + pgvector)
DATABASE_URL=postgresql://stillo:stillo@localhost:5432/stillo?schema=public

# Redis (cache + filas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=troque-isto-em-producao-access
JWT_REFRESH_SECRET=troque-isto-em-producao-refresh
JWT_ACCESS_TTL=900            # 15 min
JWT_REFRESH_TTL=2592000       # 30 dias

# IA — provider abstraído (ver ADR-0003). Default OpenAI.
AI_PROVIDER=openai            # openai | anthropic | azure-openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# OCR
OCR_PROVIDER=tesseract        # tesseract | google-document-ai | aws-textract
GOOGLE_DOCUMENT_AI_KEY=

# Storage (Supabase Storage / S3 compatível)
STORAGE_PROVIDER=supabase     # supabase | s3 | local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=stillo-uploads
